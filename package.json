{
  "name": "@noukai/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for executing Noukai flows",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/express": {
      "import": "./dist/adapters/express.js",
      "types": "./dist/adapters/express.d.ts"
    },
    "./adapters/nextjs": {
      "import": "./dist/adapters/nextjs.js",
      "types": "./dist/adapters/nextjs.d.ts"
    },
    "./adapters/relay": {
      "import": "./dist/adapters/relay.js",
      "types": "./dist/adapters/relay.d.ts"
    }
  },
  "engines": { "node": ">=18.0.0" },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "license": "MIT",
  "homepage": "https://noukai.dev",
  "repository": { "type": "git", "url": "git+https://github.com/abigcircle/noukai-typescript-sdk.git" },
  "bugs": { "url": "https://github.com/abigcircle/noukai-typescript-sdk/issues" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run tests/*.test.ts tests/adapters/*.test.ts",
    "test:unit": "vitest run tests/*.test.ts tests/adapters/*.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "next": "^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true },
    "express": { "optional": true },
    "next": { "optional": true }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/express": "^5",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^3",
    "dotenv": "^16",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "express": "^5",
    "prettier": "^3",
    "tsup": "^8",
    "typescript": "^5.5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
